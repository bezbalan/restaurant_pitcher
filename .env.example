# --- Restaurant data (optional; demo data is used without it) ---
# Google Places API (New). Server-side only — never prefixed with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=

# --- Shared rooms storage (required for multi-device on Vercel/serverless) ---
# Without these, rooms live in server memory: fine for `npm run dev`/`npm start`
# on one machine, NOT for Vercel (each serverless instance has its own memory).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
